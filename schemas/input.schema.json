{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mic-50-90:schema:input:1.0",
  "title": "MIC-50-90 v1 input",
  "type": "object",
  "required": [
    "contract_version",
    "mode",
    "n",
    "panel",
    "summaries",
    "thresholds"
  ],
  "additionalProperties": false,
  "$defs": {
    "quantile": {
      "type": "object",
      "required": [
        "probability",
        "category"
      ],
      "additionalProperties": false,
      "properties": {
        "probability": {
          "description": "Decimal probability in (0, 1]; strings preserve exact decimal digits. The parser checks the string's numeric range.",
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            {
              "type": "string",
              "pattern": "^[+]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
            }
          ]
        },
        "category": {
          "type": [
            "string",
            "number"
          ]
        },
        "convention": {
          "type": "string",
          "default": "ceiling"
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "summaries": {
      "type": "object",
      "required": [
        "quantiles"
      ],
      "additionalProperties": false,
      "properties": {
        "quantiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/quantile"
          }
        },
        "minimum": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "maximum": {
          "type": [
            "string",
            "number",
            "null"
          ]
        }
      }
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "contract_version": {
      "const": "1.0"
    },
    "mode": {
      "enum": [
        "empirical",
        "population"
      ]
    },
    "n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "panel": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "levels"
          ],
          "additionalProperties": false,
          "properties": {
            "levels": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "description": "Tested concentrations in mg/L, strictly increasing. Supplying them asserts half-open categories: a reading of v means the inhibitory concentration lies in (previous level, v]. The lowest category is left-censored unless left_censored is false, which claims more than a dilution reading supports. An open top category is represented one dilution above the last level; that representative enters the recorded-panel estimand and the transport positions, never the sharp bounds."
            },
            "left_censored": {
              "type": "boolean",
              "default": true
            },
            "right_censored": {
              "type": "boolean",
              "default": true
            }
          }
        },
        {
          "type": "object",
          "required": [
            "categories"
          ],
          "additionalProperties": false,
          "properties": {
            "categories": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "lower_bound",
                  "upper_bound",
                  "lower_closed",
                  "upper_closed",
                  "panel_value"
                ],
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "lower_bound": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "upper_bound": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "lower_closed": {
                    "type": "boolean"
                  },
                  "upper_closed": {
                    "type": "boolean"
                  },
                  "panel_value": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "summaries": {
      "$ref": "#/$defs/summaries"
    },
    "reporting_envelope": {
      "type": "object",
      "required": [
        "variants"
      ],
      "additionalProperties": false,
      "properties": {
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "summaries"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "summaries": {
                "$ref": "#/$defs/summaries"
              }
            }
          }
        }
      }
    },
    "thresholds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "reference_distribution": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      ]
    },
    "wasserstein_radius": {
      "type": "number",
      "minimum": 0
    },
    "wasserstein_calibration_manifest": {
      "type": "object",
      "required": [
        "manifest_version",
        "guarantee_class",
        "confidence_level",
        "alpha",
        "rank",
        "calibration_size",
        "minimum_group_calibration_size",
        "radius",
        "grouping",
        "source",
        "data_hashes",
        "guarantee_scope",
        "fallback_used",
        "calibration_scores_sha256",
        "coverage_statement"
      ],
      "additionalProperties": false,
      "properties": {
        "manifest_version": {
          "enum": [
            "1.0",
            "1.1",
            "1.2",
            "1.3"
          ]
        },
        "guarantee_class": {
          "const": "conformal_new_cohort"
        },
        "confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "requested_level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "requested_level_supported": {
          "type": "boolean"
        },
        "exchangeable_units": {
          "type": "integer",
          "minimum": 1
        },
        "exchangeable_unit_definition": {
          "type": "string",
          "minLength": 1
        },
        "exchangeable_unit_labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unit_score_aggregation": {
          "enum": [
            "max",
            "median"
          ]
        },
        "maximum_supported_level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "attained_level": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "calibration_size": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_group_calibration_size": {
          "type": "integer",
          "minimum": 1
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "grouping": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "data_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "guarantee_scope": {
          "enum": [
            "declared_group_marginal",
            "global_marginal"
          ]
        },
        "fallback_used": {
          "type": "boolean"
        },
        "calibration_scores_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "coverage_statement": {
          "type": "string",
          "minLength": 1
        },
        "calibration_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score_kind",
            "reference_rule",
            "functional_scope",
            "transport_unit",
            "summary_policy",
            "reference_protocol",
            "unit_definition"
          ],
          "properties": {
            "score_kind": {
              "enum": [
                "simultaneous_tail_intervals",
                "distribution_distance"
              ]
            },
            "reference_rule": {
              "enum": [
                "raw",
                "projected"
              ]
            },
            "functional_scope": {
              "const": "all_panel_tails"
            },
            "transport_unit": {
              "enum": [
                "log2_mg_L",
                "normalized_log2_mg_L"
              ]
            },
            "summary_policy": {
              "const": "ceiling_50_90_no_range"
            },
            "reference_protocol": {
              "type": "string",
              "minLength": 1
            },
            "unit_definition": {
              "type": "string",
              "minLength": 1
            },
            "transport_scaling": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "panels",
                "training_unit_labels"
              ],
              "properties": {
                "method": {
                  "const": "training_loo_max"
                },
                "training_unit_labels": {
                  "type": "array",
                  "minItems": 2,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "panels": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "scale",
                      "panel_sha256"
                    ],
                    "properties": {
                      "scale": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "panel_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    }
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "transport_unit": {
                    "const": "normalized_log2_mg_L"
                  }
                }
              },
              "then": {
                "required": [
                  "transport_scaling"
                ],
                "properties": {
                  "reference_rule": {
                    "const": "projected"
                  },
                  "score_kind": {
                    "const": "simultaneous_tail_intervals"
                  }
                }
              },
              "else": {
                "not": {
                  "required": [
                    "transport_scaling"
                  ]
                }
              }
            }
          ]
        },
        "conformal_rank_counts": {
          "enum": [
            "units",
            "cohorts"
          ]
        },
        "unit_scores": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "unit_scores_median": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "attained_level_all_cohorts": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "attained_level_median_cohort": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exact_count_confidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "confidence_level": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "multiplicity": {
              "enum": [
                "bonferroni",
                "none"
              ]
            }
          }
        },
        "profile_likelihood_enabled": {
          "type": "boolean"
        },
        "profile_grid_size": {
          "type": "integer",
          "minimum": 11
        },
        "confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "bayes_enabled": {
          "type": "boolean"
        },
        "bayes_draws": {
          "type": "integer",
          "minimum": 1000
        },
        "seed": {
          "type": "integer"
        },
        "dirichlet_concentration": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "question_utility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "exclude_direct_target_questions": {
          "type": "boolean",
          "default": false
        },
        "costs": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "time_limit_seconds": {
          "type": "number",
          "minimum": 0,
          "default": 10
        }
      }
    },
    "calibration_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "reference_protocol",
        "grouping"
      ],
      "properties": {
        "unit": {
          "const": "mg/L"
        },
        "reference_protocol": {
          "type": "string"
        },
        "grouping": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "panel_id": {
          "type": "string",
          "minLength": 1
        },
        "preparation_binding": {
          "type": "object",
          "description": "Hash-bound preparation mapping checked against its manifest and the actual cohort and panel."
        }
      }
    }
  }
}
