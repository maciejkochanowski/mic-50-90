{
  "$schema": "../schemas/input.schema.json",
  "contract_version": "1.0",
  "mode": "empirical",
  "n": 100,
  "panel": {
    "levels": [0.125, 0.25, 0.5, 1, 2, 4, 8, 16, 32, 64],
    "left_censored": true,
    "right_censored": true
  },
  "summaries": {
    "quantiles": [
      {"probability": 0.5, "category": "0.5"},
      {"probability": 0.9, "category": "16"}
    ],
    "minimum": "<=0.125",
    "maximum": ">64"
  },
  "reporting_envelope": {
    "variants": [
      {
        "id": "explicit-nearest-ranks",
        "summaries": {
          "quantiles": [
            {"probability": 0.5, "rank": 50, "category": "0.5"},
            {"probability": 0.9, "rank": 90, "category": "16"}
          ],
          "minimum": "<=0.125",
          "maximum": ">64"
        }
      }
    ]
  },
  "thresholds": [2, 8],
  "question_utility": {
    "enabled": true,
    "exclude_direct_target_questions": true
  }
}
